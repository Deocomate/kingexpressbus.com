<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
    RewriteEngine On

    # 1. Ép buộc sử dụng HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- THÊM MỚI TẠI ĐÂY ---
    # Chuyển hướng 301: Xóa chữ /public/ trên URL nếu người dùng/bot truy cập trực tiếp
    # Dùng %{THE_REQUEST} để bắt đúng URL thô từ browser, tránh vòng lặp với rule nội bộ
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [L,R=301,NE]
    # ------------------------

    # 2. Xử lý Authorization Header cho API/Sanctum
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Chuyển hướng các request bỏ dấu slash (/) ở cuối
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 4. CHỈ phục vụ trực tiếp nếu đó là một FILE có thật (ví dụ: .css, .js, .jpg)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Tất cả các request còn lại đều trỏ về index.php của Laravel
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
