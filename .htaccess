<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Ép buộc sử dụng HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Xử lý Authorization Header cho API/Sanctum
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Chuyển hướng các request bỏ dấu slash (/) ở cuối
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 4. Nếu file hoặc thư mục CÓ THẬT bên trong thư mục /public (Ví dụ: css, js, hình ảnh) -> Cho phép truy cập trực tiếp
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Nếu không phải file/thư mục có thật, đẩy TẤT CẢ các request còn lại vào file index.php của Laravel
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
